# The v1 archive keeps its own .gitignore at v1/.gitignore.
# This file covers the rebuild that happens at the repository root.

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Node
node_modules/
.svelte-kit/
dist/
build/
.vite/
playwright-report/
test-results/

# A concurrent session's checkout. The worktree holds real tracked files, so
# without this they show up as untracked in whichever tree looks first.
.claude/worktrees/

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Secrets and local config
.env
.env.*
!.env.example

# Transient output
*.log
*.tmp
*.partial

# Vault state and canonical objects must never enter this repository
objects/
records/
state/
exports/
reports/
logs/
conflicts/
derivatives/
*.blob
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db
*.db-wal
*.db-shm
*.db-journal

# Working trees the build writes to. These live outside the repository (see
# config.toml); the patterns are a backstop in case one is ever created here.
thumb/
deriv/
meta/
staging/
.staging/

# Line-delimited JSON: origins.jsonl and any other export or run record
*.jsonl

# UI assets are caught by the media patterns below. If the grid or triage UI ever
# needs a committed image, icon or font, stage it explicitly with `git add -f`.

# Source media must never enter this repository
*.jpg
*.jpeg
*.jpe
*.png
*.gif
*.webp
*.heic
*.heif
*.avif
*.bmp
*.tif
*.tiff
*.raw
*.dng
*.cr2
*.cr3
*.nef
*.nrw
*.arw
*.orf
*.rw2
*.raf
*.pef
*.srw
*.3fr
*.erf
*.kdc
*.mef
*.mos
*.mrw
*.x3f
*.mp4
*.mov
*.m4v
*.avi
*.mkv
*.webm
*.mts
*.m2ts
*.mpg
*.mpeg
*.wmv
