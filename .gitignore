# The v1 archive keeps its own .gitignore at v1/.gitignore.
# This file covers the rebuild that happens at the repository root.

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Node
node_modules/
.svelte-kit/
dist/
build/
.vite/
playwright-report/
test-results/

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Secrets and local config
.env
.env.*
!.env.example

# Transient output
*.log
*.tmp
*.partial

# Vault state and canonical objects must never enter this repository
objects/
records/
state/
exports/
reports/
logs/
conflicts/
derivatives/
*.blob
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db
*.db-wal
*.db-shm
*.db-journal

# Source media must never enter this repository
*.jpg
*.jpeg
*.jpe
*.png
*.gif
*.webp
*.heic
*.heif
*.avif
*.bmp
*.tif
*.tiff
*.raw
*.dng
